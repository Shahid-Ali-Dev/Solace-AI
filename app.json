{
  "expo": {
    "name": "Solace AI",
    "slug": "solace-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solace.wellness"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0F17"
      },
      "package": "com.solace.wellness",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#2DD4BF",
          "defaultChannel": "solace-reminders"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.864428998943-bp1jht47rvesfs4ealnst5ikio3odgs2"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0B0F17",
            "image": "./assets/icon.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec9f1660-7e64-488f-ac4e-c43f675ec6b4"
      }
    }
  }
}